     ]
    }
   ],
   "source": [
    "# Pour les 6 départements, si la population du département est inférieure à 400000 habitants et la superficie > 6000 km²,\n",
    "# alors afficher le département\n",
    "for i in range(6):\n",
    "    if L_popu[i] < 400000 and L_super[i] > 6000:\n",
    "        print(L_depart[i])\n",
    "# Résultat attendu:\n",
    "# Gers\n",
    "\n",
    "####"
   ]
  },
