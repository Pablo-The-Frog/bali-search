   ],
   "source": [
    "# On veut calculer la variation de la population du Gers tous les ans\n",
    "# Les valeurs fournies par Wikipédia sont ( année: nbre habitants) :\n",
    "# 1968:181577 1975:175366 1982:174154 1990:174587 1999:172335 2010:188159 2015:190932 2021:192437\n",
    "# Soit la liste ( int ) des années L_annee contenant 1968  1975 ...\n",
    "# Soit la liste ( int ) du nombre d'habitants L_habit contenant 181577 175366 ...  \n",
    "L_annee = [1968,1975,1982,1990,1999,2010,2015,2021]\n",
    "L_habit = [181577,175366,174154,174587,172335,188159,190932,192437]\n",
    "# Ecrire le script qui affiche la variation de population par an en %. \n",
    "for i in range(len(L_annee)-1):\n",
    "    var = (L_habit[i+1] - L_habit[i]) / (L_annee[i+1] - L_annee[i])\n",
    "    print(100*var / L_habit[i])\n",
    "\"\"\" Résultat attendu:\n",
    "-0.48865534417118595\n",
    "-0.09873228399054386\n",
    "0.03107881530139991\n",
    "-0.14332236777206908\n",
    "0.8347378388287083\n",
    "0.2947507161496394\n",
    "0.1313731241139952\n",
    "\"\"\"\n",
    "####"
   ]
  }
