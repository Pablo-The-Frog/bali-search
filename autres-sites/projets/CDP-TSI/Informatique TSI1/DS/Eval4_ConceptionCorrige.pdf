   "source": [
    "# Objectif: concevoir et écrire des courts programmes \n",
    "# Compétence: maîtriser les bases de  Python et notamment les règles de syntaxe\n",
    "# Activité: traduire en langage Python les requêtes suivantes"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "241264f1-5170-4c78-882f-a3a6f6562cef",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Soit la liste de str L_depart des départements Pyrénées-Atlantiques, Landes, Gironde, Dordogne, Lot-et-Garonne, Gers\n",
    "L_depart=['Pyrénées-Atlantiques', 'Landes', 'Gironde', 'Dordogne', 'Lot-et-Garonne', 'Gers']\n",
    "# Soit la liste d'entiers L_popu du nombre d'habitants correspondant: 693027, 422976, 1654970, 413730, 331229, 192437.\n",
    "L_popu = [693027, 422976, 1654970, 413730, 331229, 192437]\n",
    "# Soit la liste d'entiers L_surface des superficies des départements correspondants en km²: 7644, 9242, 9975 , 9060, 5360, 6256\n",
    "L_super = [7644, 9242, 9975 , 9060, 5360, 6256]\n",
    "# Soit la liste de str L_code des codes INSEE des départements : 64, 40, 33, 24, 47, 32. \n",
    "L_code = ['64', '40', '33', '24', '47', '32']\n",
    "\n",
    "####"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "750d3fe3-c6e5-40d2-b0fe-14ca64e3e9e8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Le département Landes a une superficie de 9242 km².\n"
     ]
    }
   ],
   "source": [
    "# Afficher dans la console en utilisant les listes ci-dessus: Le département Landes a une superficie de 9242 km².\n",
    "print(\"Le département \" + L_depart[1] + \" a une superficie de \" + str(L_super[1]) + \" km².\")\n",
    "# Résultat attendu:\n",
    "# Le département Landes a une superficie de 9242 km².\n",
    "####"
   ]
  },
