   ],
   "source": [
    "# Pour les n éléments de la liste L_depart, afficher le département suivi de son code INSEE séparé d'un espace.\n",
    "for i in range(len(L_depart)):\n",
    "    print(L_depart[i]+' '+L_code[i])\n",
    "\"\"\" Résultat attendu:\n",
    "Pyrénées-Atlantiques 64\n",
    "Landes 40\n",
    "Gironde 33\n",
    "Dordogne 24\n",
    "Lot-et-Garonne 47\n",
    "Gers 32 \n",
    "\"\"\"\n",
    "####"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "4819da6d-23a1-4030-b37d-4404912f9240",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[90.66287284144427, 45.76671716078771, 165.91177944862156, 45.66556291390729, 61.7964552238806, 30.760390025575447]\n"
     ]
    }
   ],
   "source": [
    "# Soit la fonction densite() qui prend comme arguments la liste du nombre d'habitants et la liste des superficies,\n",
    "# elle renvoie la liste des densités de population en nombre d'habitants au km².\n",
    "def densite(pop:[int],sur:[int]):\n",
    "    s=[]\n",
    "    for i in range(len(pop)):\n",
    "        s.append(pop[i]/sur[i])\n",
    "    return s\n",
    "\n",
    "# Appeler cette fonction pour les 6 départements et afficher les densités de population\n",
    "print(densite(L_popu,L_super))\n",
    "# Résultat attendu:\n",
    "# [90.66287284144427, 45.76671716078771, 165.91177944862156, 45.66556291390729, 61.7964552238806, 30.760390025575447]\n",
    "\n",
    "####"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "f7cd3297-caaf-4687-9bc4-59d6cecb1413",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Densité de population du département Gers : 30.8 hab/km²\n"
     ]
    }
   ],
   "source": [
    "# Rappel: le nombre de décimales d'un flottant arrondi peut être paramétré avec la fonction round(flottant,nbre décimales)\n",
    "# En utilisant la fonction densite(), afficher sur une seule ligne: Densité de population du département Gers : 30.8 hab/km².\n",
    "print('Densité de population du département '+L_depart[5]+' : ' + str(round(densite(L_popu,L_super)[5],1))+\" hab/km²\")\n",
    "# Résultat attendu:\n",
    "# Densité de population du départment Gers : 30.8 hab/km²\n",
    "\n",
    "####"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "cf2e6fb4-31c6-491c-91a8-6d191c998822",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "PyrénéesAtlantiques\n"
     ]
    }
   ],
   "source": [
    "# Mon application n'accepte pas les caractères spéciaux comme le trait d'union.\n",
    "# Il faut donc convertir Pyrénées-Atlantiques en PyrénéesAtlantiques\n",
    "# Méthode: on splitte avec le - et on concatène \n",
    "# Soit la variable dep ='Pyrénées-Atlantiques', écrire le script qui traite cette variable.\n",
    "dep ='Pyrénées-Atlantiques'\n",
    "s=dep.split('-')\n",
    "dep= s[0]+s[1]\n",
    "print(dep)\n",
    "\n",
    "####"
   ]
  },
  {
   "cell_type": "code",
