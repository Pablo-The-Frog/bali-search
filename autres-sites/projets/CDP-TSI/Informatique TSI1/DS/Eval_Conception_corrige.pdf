   "source": [
    "# Définir une fonction six_cartes() qui prend aucun argument et qui renvoie une liste de 6 cartes aléatoires\n",
    "def six_cartes():\n",
    "    lst_cartes=[]\n",
    "    for i in range(6):\n",
    "        lst_cartes.append(choice(['Pique','Carreau','Coeur','Trèfle']))\n",
    "    return lst_cartes\n",
    "print(six_cartes())"
   ]
  }
