   "source": [
    "from random import choice\n",
    "carte=choice(['Pique','Carreau','Coeur','Trèfle'])\n",
    "print(carte)\n",
    "while carte != 'Coeur':\n",
    "    carte=choice(['Pique','Carreau','Coeur','Trèfle'])\n",
    "    print(carte)\n",
    "    "
   ]
