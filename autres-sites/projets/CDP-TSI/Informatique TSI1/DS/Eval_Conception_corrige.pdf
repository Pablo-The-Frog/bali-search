   "source": [
    "# Soit la variable matiere contenant la chaîne de caractères maths en minuscules.\n",
    "matiere=\"maths\"\n",
    "# Soit la variable nbre_matieres contenant la valeur entière 6\n",
    "nbre_matieres=6\n",
    "# Soit la variable moy_maths contenant 12,3\n",
    "moy_maths=12.3\n",
    "# Soit la liste mes_pots contenant Axel, Richard, Marc et Antoine.\n",
    "mes_pots=[\"Axel\",\"Richard\",\"Marc\",\"Antoine\"]\n",
    "# Afficher sur une seule ligne ma moyenne en maths comme ceci: Ma moyenne en maths est de .... sur 20.\n",
    "print(\"Ma moyenne en maths est de\",moy_maths,\"sur 20\")\n",
    "# Afficher les deux premiers éléments de la variable matiere\n",
    "print(matiere[:2])\n",
    "# Afficher les deux dernières lettres de la variable matiere\n",
    "print(matiere[-2:])\n",
    "# Afficher la concaténation des éléments de la liste mes_pots\n",
    "print(mes_pots[0]+mes_pots[1]+mes_pots[2]+mes_pots[3])\n",
    "# Afficher le nombre d'éléments de la liste mes_pots\n",
    "print(len(mes_pots))"
   ]
