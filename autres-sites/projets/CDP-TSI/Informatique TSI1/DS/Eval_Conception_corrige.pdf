   "source": [
    "# Soit la fonction choice() qui prend comme argument une liste et qui renvoie un élément aléatoire de cette liste\n",
    "# Exemple choice([2,8,6,4]) renvoie 2 ou 8 ou 6 ou 4\n",
    "# Importer le module choice de la librairie random\n",
    "# Ecrire un script qui tire une carte au hasard parmi Pique, Carreau, Coeur et Trèfle et qui l'affiche \n",
    "# jusqu'à ce que la carte coeur soit tirée."
   ]
