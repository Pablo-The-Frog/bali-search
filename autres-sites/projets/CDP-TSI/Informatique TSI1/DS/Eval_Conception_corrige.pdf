    "# Soit la fonction vitesse_lin() qui prend comme arguments le temps t en seconde et la distance d en kilomètres\n",
    "# et qui renvoie la vitesse linéaire en m/s\n",
    "def vitesse_lin(t:float,d:float):\n",
    "    return 1000*d/t"
   ]
