   "source": [
    "# Soit le module sqrt de la librairie math( ce module calcule la racine carrée d'un flottant )\n",
    "from math import sqrt\n",
    "# Soit la fonction hypo() qui prend comme arguments deux réels a et b et qui renvoie la valeur de l'ypothénuse\n",
    "def hypo(a:float,b:float):\n",
    "    return sqrt(a**2 + b**2)\n",
    "# Afficher l'hypothénuse d'un triangle rectangle de côtés 3 et 4\n",
    "print(hypo(3,4))"
   ]
