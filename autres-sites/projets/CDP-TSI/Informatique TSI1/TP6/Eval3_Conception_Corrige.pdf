   "source": [
    "# Soit la variable lycee contenant la chaîne de caractères Saint-Cricq.\n",
    "lycee ='Saint-Cricq'\n",
    "# Soit la variable nbre_lettres contenant le nombre de lettres de la variable lycee\n",
    "nbre_lettres=len(lycee)\n",
    "# Soit la variable classement_lycee contenant le résultat du calcul : 15,3 . 12 / 100\n",
    "classement_lycee=15.3*12/100\n",
    "# Soit la liste sections contenant STI2D, BTS, BacPro et BacG.\n",
    "sections=['STI2D','BTS','BacPro','BacG']\n",
    "# Ajouter à cette liste STMG\n",
    "sections.append('STMG')\n",
    "# Afficher le deuxième élément et le dernier de la liste sections sur une seule ligne\n",
    "print(sections[1],sections[-1])\n",
    "# Afficher la sous-liste [BTS,BacPro] en utilisant le slicing\n",
    "print(sections[1:3])\n",
    "####"
   ]
