   "source": [
    "# Soit la liste des noms des 3 escargots: speedy, pépouze, chill:\n",
    "noms = ['speedy', 'pépouze', 'chill' ]\n",
    "# Afficher un mot de passe constitué des deux premières lettres du premier attachées au 4° et 5° du deuxième\n",
    "# attachées aux trois dernières du dernier en utilisant le slicing ( of course d'es... )\n",
    "escargot1= noms[0]\n",
    "escargot2= noms[1]\n",
    "escargot3= noms[2]\n",
    "print(escargot1[:2] + escargot2[3:5] + escargot3[-3:])\n",
    "####"
   ]
  }
