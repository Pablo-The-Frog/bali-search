    "# Soit xA=2.0\n",
    "xA=2.0\n",
    "# Soit la fonction f(x) qui renvoie x² -2x +1\n",
    "def f(x):\n",
    "    return x**2 - 2*x +1\n",
    "# Afficher le résultat de f(xA) et de f(3) sur une même ligne\n",
    "print(f(xA),f(3))\n",
    "####"
   ]
