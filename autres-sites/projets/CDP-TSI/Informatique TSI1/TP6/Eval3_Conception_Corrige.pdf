   "source": [
    "# Soit la liste des temps en minutes lst_temps pour plusieurs escargots qui ont parcouru 50m en 300,350,380 minutes\n",
    "lst_temps = [300,350,380 ]\n",
    "# En utilisant la fonction précédente escargot() et une boucle for ... afficher les vitesses en cm/s de ces 3 escargots.\n",
    "for t in lst_temps:\n",
    "    print(escargot(t/60, 50 )/10 )\n",
    "####"
   ]
