   "source": [
    "# Soit la fonction escargot() qui prend comme arguments le temps t en heure et la distance d en mètres\n",
    "# et qui renvoie la vitesse linéaire en mm/s d'un escargot\n",
    "def escargot(t:float,d:float):\n",
    "    return 1000*d/3600/t\n",
    "####"
   ]
