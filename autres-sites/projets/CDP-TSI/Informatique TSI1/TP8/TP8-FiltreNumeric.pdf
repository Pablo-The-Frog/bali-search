# -*- coding: utf-8 -*-
"""
Signal informatif 0.1V 1kHz + Parasite 50mV 25kHz
Filtrage passe-bas Ordre 1 fc = 5kHz
"""
import numpy as np
import matplotlib.pyplot as plt
from numpy.fft import fft, fftfreq

Fs=1000 # Fréquence signal sinus 1kHz
Fp=25000 # Fréquence parasite sinus 25kHz
As=0.1 # Amplitude signal sinus 100mV
Ap=50E-3  # Amplitude parasite 5mV
tmax=5E-3 # 5ms soit 5 périodes
n=5000 # 5000 points de calcul
Te=tmax/n # période d'échantillonnage

"Signal parasité en fonction du temps"
t=np.linspace(0,tmax,n) # liste de valeurs de temps en s
signal=As*np.sin(2*np.pi*Fs*t)+Ap*np.sin(2*np.pi*Fp*t)

"Calcul du signal filtré"
filtre1=np.array([0.0])
for i in range(n-1):
    filtre1=np.append(filtre1,0.030459*signal[i+1]+0.96954097*filtre1[i])

plt.subplot(3,1,1)
plt.plot(t,signal,color='r',linewidth='2')
plt.plot(t,filtre1,color='black',linewidth='2')
plt.xlabel("Temps(s)")
plt.ylabel("Signal(mV)")
plt.title("Sinus 100mV/1kHz + 50mV/25kHz low-pass ordre 1 fc=5kHz")

Xs = fft(signal)  
freq = fftfreq(signal.size, d=Te)  
plt.subplot(3,1,2)
plt.plot(freq[:n//2], np.abs(Xs[:n//2])*2.0/n,color='r',linewidth='2')
plt.xlim(100, 100E3) 
plt.semilogx() 
plt.xlabel("Fréquence (Hz)")
plt.ylabel(r"Amplitude signal")

Xf = fft(filtre1)  
freq = fftfreq(signal.size, d=Te)  
plt.subplot(3,1,3)
plt.plot(freq[:n//2], np.abs(Xf[:n//2])*2.0/n,color='black',linewidth='2')
plt.xlim(100, 100E3)
plt.semilogx()  
plt.grid()
plt.xlabel(r"Fréquence (Hz)")
plt.ylabel(r"Amplitude signal filtré")
