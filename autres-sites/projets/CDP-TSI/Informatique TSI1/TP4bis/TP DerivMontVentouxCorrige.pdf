   "source": [
    "# Soit la liste des altitudes en mètres tous les 1km\n",
    "alt_MontVentoux=[319,350,388,447,499,535,622,713,813,917,1010,1108,1198,1290,1376,1443,1507,1570,1643,1730,1815]\n",
    "def calculerPentes(distance:float,altitude:[float]):\n",
    "    # Cette fonction renvoie les pentes en % tous les km\n",
    "    lst_pentes=[]\n",
    "    for i in range(len(altitude)-1):\n",
    "        lst_pentes.append(100*(altitude[i+1]-altitude[i])/1000)\n",
    "        print(i,altitude[i],altitude[i+1],lst_pentes)\n",
    "    return lst_pentes\n",
    "print(calculerPentes(1000,alt_MontVentoux))\n"
   ]
  },
