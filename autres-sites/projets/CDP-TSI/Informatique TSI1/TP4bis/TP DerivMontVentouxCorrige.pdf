   "cell_type": "markdown",
   "id": "c53aa2fb-c180-431a-ae7c-fff9365a4012",
   "metadata": {},
   "source": [
    "Problème 1: vitesse instantannée"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5b71b0d5-5100-4974-b643-a190e456c6dd",
   "metadata": {},
   "outputs": [],
   "source": [
    "bolt=[0.183,1.78,1.02,0.9,0.88,0.88,0.85,0.85,0.86,0.86,0.89,9.95]\n",
    "def vitesse_instantanee1(nom:[]):\n",
    "    vit=[0]\n",
    "    for i in range(1,len(nom)-1):\n",
    "        vit.append(round(10/nom[i],2))\n",
    "        print(i,nom[i],vit)\n",
    "    return vit\n",
    "print(vitesse_instantanee1(bolt))\n",
    "    "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c7905f49-0c3c-4e2f-8a88-f5e84907d3eb",
   "metadata": {},
   "outputs": [],
   "source": [
    "bolt=[0.183,1.78,1.02,0.9,0.88,0.88,0.85,0.85,0.86,0.86,0.89,9.95]\n",
    "def vitesse_instantanee2(nom:[]):\n",
    "    vit=[0]\n",
    "    for i in range(len(nom)-2):\n",
    "        vit.append(round(3.6*10/nom[i+1],2))\n",
    "        print(i,nom[i+1],vit)\n",
    "    return vit\n",
    "print(vitesse_instantanee2(bolt))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "04a7680f-d632-4e68-832d-d084d65fbf4a",
   "metadata": {},
   "source": [
    "Problème 2: vitesse maximale"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f731c36f-4f3f-4060-abbc-a4fb1a3bdd3d",
   "metadata": {},
   "outputs": [],
   "source": [
    "vit_bolt=vitesse_instantanee2(bolt)\n",
    "vit_max=0\n",
    "for vit in vit_bolt:\n",
    "    if vit>vit_max:\n",
    "        vit_max=vit\n",
    "    print(vit,vit_max)\n",
    "print(\"Vitesse maximale de Usain Bolt:\",vit_max,\"km/h\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "250ba04f-3dba-4d7d-b4d2-c02a95c0f8f9",
   "metadata": {},
   "source": [
    "Problème 3: accélérations instantanées"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ec19ce6b-b491-4cc3-a4e4-1d3599aa148f",
   "metadata": {},
   "outputs": [],
   "source": [
    "vit_bolt=vitesse_instantanee1(bolt)\n",
    "accel=[0]\n",
    "for i in range(len(vit_bolt)-1):\n",
    "    accel.append(round((vit_bolt[i+1]-vit_bolt[i])/bolt[i+1],2))\n",
    "    print(i,vit_bolt[i], vit_bolt[i+1],accel)\n",
    "print(accel)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2d8e8524-52b0-45dc-b6c8-a555a5a68ad1",
   "metadata": {},
   "outputs": [],
   "source": [
    "def accels(vit:[],chronos:[]):\n",
    "    accel=[0]\n",
    "    for i in range(len(vit)-1):\n",
    "        accel.append(round((vit[i+1]-vit[i])/chronos[i+1],2))\n",
    "        print(i,vit[i], vit[i+1],chronos[i+1],accel)\n",
    "    return accel\n",
    "print(accels(vitesse_instantanee1(bolt),bolt))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "11a237cd-0711-4d35-9d9a-c7c389fc579d",
   "metadata": {},
   "source": [
    "Problème 4 : Soit à déterminer par intégration numérique l’énergie produite à partir des mesures de puissances instantanées."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "17c858b7-2a6d-42e1-8680-7b568a7c1e41",
   "metadata": {},
   "outputs": [],
   "source": [
    "\"\"\" Listes des valeurs de puissances relevées en Watt toutes les 5 minutes\"\"\"\n",
    "puissances=[10,10,20,55,80,60,96,75,50,68,60,45,24]\n",
    "\"\"\" Calcul de l'énergie produite sur une heure par la méthode des trapèzes\"\"\"\n",
    "energie=0\n",
    "for i in range(len(puissances)-1):\n",
    "    energie=energie+5*(puissances[i+1]+puissances[i])/2\n",
    "    print(i,puissances[i],puissances[i+1],energie)\n",
    "print (\"Energie produite sur une heure en Wh: \",energie/60)"
   ]
  },
