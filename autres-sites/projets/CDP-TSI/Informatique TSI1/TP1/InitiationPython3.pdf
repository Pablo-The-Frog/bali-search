  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "collapsed": false,
    "jupyter": {
     "outputs_hidden": false
    }
   },
   "outputs": [],
   "source": [
    "t=(1,2,3,4)\n",
    "s=(2.5,3.6,5,8)\n",
    "mix=('Marc',28,6.35,'07568941')\n",
    "print (t[0],len(s),t+s,(5 in t),mix)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Les listes sont modifiables et leurs contenus peuvent être aussi hétérogènes."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "collapsed": false,
    "jupyter": {
     "outputs_hidden": false
    }
   },
   "outputs": [],
   "source": [
    "prenoms=['Claude','Jeff','Gaston']\n",
    "ages=[20,25,24]\n",
    "poids=[65.3,57.8,86.2]\n",
    "print (prenoms[0],ages[0],poids[0])\n",
    "ages[1]=22\n",
    "print (ages)\n",
    "print (poids[0:1],poids[1:3],len(prenoms))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
