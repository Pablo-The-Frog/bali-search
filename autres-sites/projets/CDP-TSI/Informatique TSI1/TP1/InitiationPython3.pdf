    "animal='cheval'\n",
    "race='Pur sang'\n",
    "sexe='femelle'\n",
    "print (animal+race+sexe)\n",
    "print (\"Mon cheval est un \",race,\"\\nde sexe \",sexe)\n",
    "print (animal[3:5],len(race),\"r\" in sexe)\n",
    "print( race.lower(),sexe.upper(),ord(\"A\"),chr(65))"
   ]
