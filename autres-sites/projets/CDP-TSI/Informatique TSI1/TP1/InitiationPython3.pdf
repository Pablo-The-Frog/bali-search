  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Déclaration et appel d'une fonction"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "collapsed": false,
    "jupyter": {
     "outputs_hidden": false
    }
   },
   "outputs": [],
   "source": [
    "def cube(w):\n",
    "    return w**3\n",
    "print (cube(2),cube(3))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "collapsed": false,
    "jupyter": {
     "outputs_hidden": false
    }
   },
   "outputs": [],
   "source": [
    "def tablemulti(base,debut,fin):\n",
    "    n=debut\n",
    "    while n<=fin:\n",
    "        print (n,\"x\",base,\"=\",n*base)\n",
    "        n=n+1\n",
    "tablemulti(2,4,6)\n",
    "tablemulti(3,5,8)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Opérations sur chaînes de caractères"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "collapsed": false,
    "jupyter": {
     "outputs_hidden": false
    }
   },
   "outputs": [],
   "source": [
    "trame=\"$GPRMC,071139.988,A,4639.8232,N,00021.6810,E,8.95,184.14,141014,1.1,W,A*65\"\n",
    "\n",
    "champs=trame.split(\",\")\n",
    "print(champs)\n",
    "print(\"\\n\\nLatitude brute=\",champs[3])\n",
    "print(\"Latitude en degrés=\",float(champs[3])/100,\"°\",champs[4])\n",
    "checksum=champs[-1].split(\"*\")\n",
    "print(\"checksum =\",int(checksum[1]))"
   ]
  },
