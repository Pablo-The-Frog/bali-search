    "print(ligne1)\n",
    "file.close()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Ouverture d'un fichier en lecture, récupération des lignes dans une liste, traitement et fermeture"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "collapsed": false,
    "jupyter": {
     "outputs_hidden": false
    }
   },
   "outputs": [],
   "source": [
    "file=open('materiel.txt','r')\n",
    "contenu=[]\n",
    "for ligne in file:\n",
    "    contenu.append(ligne)\n",
    "file.close()\n",
    "##print(contenu)\n",
    "data=contenu[1].split(';')\n",
    "print(\"Type de matériel: \"+data[0]+\" Quantité: \"+data[1])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Création d'une image noir et blanc de format 9 lignes 9 colonnes"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "collapsed": true,
    "jupyter": {
     "outputs_hidden": true
    }
   },
   "outputs": [],
   "source": [
    "dam = open('damier.pbm','w')\n",
    "dam.write(\"P1#\\n\")\n",
    "dam.write(\"9 9\\n\")\n",
    "for i in range(81):\n",
    "    if i%2==0:\n",
    "        dam.write(\"0\")\n",
    "    else:\n",
    "        dam.write(\"1\")\n",
    "dam.close()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Création d'une image en niveaux de gris aléatoires 9 par 9 "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "collapsed": false,
    "jupyter": {
     "outputs_hidden": false
    }
   },
   "outputs": [],
   "source": [
    "from random import randint\n",
    "alea = open('aleatoire.pgm','w')\n",
    "alea.write(\"P2#\\n9 9\\n\")\n",
    "for i in range(81):\n",
    "    alea.write(str(randint(1,255))+\"\\n\")\n",
    "alea.close()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Création d'une image RGB aléatoire 9 par 9 "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "collapsed": true,
    "jupyter": {
     "outputs_hidden": true
    }
   },
   "outputs": [],
   "source": [
    "from random import randint\n",
    "rgb = open('image_couleur.pnm','w')\n",
    "rgb.write(\"P3#\\n9 9\\n255\\n\")\n",
    "for i in range(81):\n",
    "    rgb.write(str(randint(1,255))+\"\\n\")\n",
    "    rgb.write(str(randint(1,255))+\"\\n\")\n",
    "    rgb.write(str(randint(1,255))+\"\\n\")\n",
    "rgb.close()"
   ]
  },
