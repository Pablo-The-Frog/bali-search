  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Ouverture et affichage d'un fichier audio de type .wav"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "collapsed": false,
    "jupyter": {
     "outputs_hidden": false
    }
   },
   "outputs": [],
   "source": [
    "%matplotlib inline\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import wave,sys\n",
    "spf = wave.open(\"D:/WinPython-64bit-3.4.3.5/notebooks/coeur.wav\",'r')\n",
    "#Extract Raw Audio from Wav File\n",
    "signal = spf.readframes(-1)\n",
    "signal = np.fromstring(signal, 'Int16')\n",
    "fs = spf.getframerate()\n",
    "print(\"Fréquence d'échantillonnage: \",fs,\"Hz   Samples:\",len(signal), \"Durée en seconde:\",len(signal)/fs)\n",
    "#If Stereo\n",
    "if spf.getnchannels() == 2:\n",
    "    print('Uniquement les fichiers mono!')\n",
    "    sys.exit(0)\n",
    "Time=np.linspace(0, len(signal)/fs, num=len(signal))\n",
    "plt.figure(1)\n",
    "plt.title('Battements du coeur')\n",
    "plt.plot(Time,signal)\n",
    "plt.show()"
   ]
  },
