     "text": [
      "Mesure de l'accélération de pesanteur (méthode linéaire): 9.806 m/s^2\n"
     ]
    }
   ],
   "source": [
    "# Chargement des bibliotèques\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "t = [0., 0.025, 0.05, 0.075, 0.1, 0.125, 0.15, 0.175, 0.2, 0.225, 0.25, 0.275, 0.3, 0.325, 0.35, 0.375, 0.4, 0.425, 0.45, 0.475, 0.5]\n",
    "x = [0.006, 0.0101, 0.002 , 0.024, 0.051, 0.073, 0.118, 0.141, 0.194, 0.247, 0.300 , 0.375, 0.434, 0.527, 0.604, 0.688, 0.788, 0.890, 0.987, 1.097, 1.23]\n",
    "\n",
    "t, x = np.array(t), np.array(x) # convertir les list en list numpy\n",
    "\n",
    "# ======\n",
    "# Méthode 1 : polyfit d'ordre 2\n",
    "# ======\n",
    "r = np.polyfit(t, x, 2) # détermine les coefficients du polynomes d'ordre 2 passant le mieux dans x, t\n",
    "p = np.poly1d(r) # construction d'une fonction p(x) = r[0]*t^2 + r[1]*t + r[2]\n",
    "\n",
    "plt.figure()\n",
    "plt.scatter(t, x, marker='+', color='b', label='Expérience')\n",
    "plt.plot(t, p(t), '--r', label='Modèle polynomial')\n",
    "plt.grid()\n",
    "plt.xlabel('t (s)')\n",
    "plt.ylabel('x (m)')\n",
    "plt.legend()\n",
    "plt.show()\n",
    "\n",
    "g = r[0]*2\n",
    "print(f\"Mesure de l'accélération de pesanteur (méthode polynomiale) : {g:.3f} m/s^2\")\n",
    "\n",
    "# ======\n",
    "# Méthode 2 : polyfit d'ordre 1, l'optimisation se fait toujours mieux par rapport à une droite que par rapport à d'autres fonction\n",
    "# ======\n",
    "r = np.polyfit(t**2, x, 1) # détermine les coefficients du polynomes d'ordre 2 passant le mieux dans x, t\n",
    "\n",
    "plt.figure()\n",
    "plt.scatter(t, x, marker='+', color='b', label='Expérience')\n",
    "plt.plot(t, r[0]*t**2 + r[1], '--r', label='Modèle linéaire')\n",
    "plt.grid()\n",
    "plt.xlabel('t (s)')\n",
    "plt.ylabel('x (m)')\n",
    "plt.legend()\n",
    "plt.show()\n",
    "\n",
    "g = r[0]*2\n",
    "print(f\"Mesure de l'accélération de pesanteur (méthode linéaire): {g:.3f} m/s^2\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8d8936df",
