   "source": [
    "from scipy import stats\n",
    "\n",
    "# 1. Nombre entier\n",
    "random_integer = stats.randint.rvs(1, 100)  # Tirage d'un entier entre 1 et 100 (compris)\n",
    "print(random_integer)\n",
    "\n",
    "# 2. Loi uniforme\n",
    "random_float = stats.uniform.rvs(0.0, 1.0)  # Tirage d'un nombre décimal entre 0.0 (inclus) et 1.0 (exclus)\n",
    "print(random_float)\n",
    "\n",
    "# 3. Loi normale\n",
    "random_normal = stats.norm.rvs(loc=0.0, scale=1.0)  # Tirage aléatoire à partir d'une distribution normale\n",
    "print(random_normal)"
   ]
  },
