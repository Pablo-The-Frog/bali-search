   "source": [
    "# Chargement des bibliothèques\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "# Générer des données aléatoires (dans cet exemple, nous utilisons une distribution normale)\n",
    "data = np.random.normal(loc=0, scale=1, size=10000)\n",
    "\n",
    "# Créer un histogramme\n",
    "plt.hist(data, bins=20, color='blue', alpha=0.2, edgecolor='black')\n",
    "\n",
    "# Personnaliser le titre et les labels des axes\n",
    "plt.title('Histogramme de tirages aléatoires')\n",
    "plt.xlabel('Valeurs')\n",
    "plt.ylabel('Fréquence')\n",
    "\n",
    "# Afficher l'histogramme\n",
    "plt.show()"
   ]
