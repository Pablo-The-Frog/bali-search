      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Mesure de l'accélération de pesanteur (méthode polynomiale) : 9.861 m/s^2\n"
     ]
    },
