   ],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "R = 1000\n",
    "C = 10e-9\n",
    "tau = R*C\n",
    "fGBF = 10000 # Hz\n",
    "TGBF = 1/fGBF\n",
    "E = 2.5 # V - tension GBF\n",
    "u0 = 0\n",
    "dt = tau /100\n",
    "t = np.arange(0, TGBF, dt)\n",
    "u = np.zeros_like(t)\n",
    "u[0] = u0\n",
    "\n",
    "for k in range(1,len(t)):\n",
    "    if t[k] < TGBF/2:\n",
    "        u[k] = u[k-1] + dt/tau * (E - u[k-1])\n",
    "    else:\n",
    "        u[k] = u[k-1] * (1 - dt/tau)\n",
    "\n",
    "plt.figure(figsize=(10,6))\n",
    "plt.plot(t, u, '.k')\n",
    "plt.grid()"
   ]
  }
 ],
