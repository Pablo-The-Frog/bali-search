   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "fGBF = 10000 # Hz\n",
    "TGBF = 1/fGBF\n",
    "t = np.arange(0,2*TGBF,tau/100)\n",
    "R = 1000\n",
    "C = 10e-9\n",
    "tau = R*C\n",
    "\n",
    "E = 2.5 # V - tension GBF\n",
    "\n",
    "u1 = E*(1-np.exp(-t[t < TGBF]/tau))\n",
    "u2 = E*np.exp(-(t[t >= TGBF]-TGBF)/tau)\n",
    "u = np.append(u1, u2)\n",
    "\n",
    "plt.figure(figsize=(10,6))\n",
    "plt.plot(t, u)\n",
    "plt.xlabel('t (s)')\n",
    "plt.ylabel('U (V)')\n",
    "plt.grid()"
   ]
  }
 ],
