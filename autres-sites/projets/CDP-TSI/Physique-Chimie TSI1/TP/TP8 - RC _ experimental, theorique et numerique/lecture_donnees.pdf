   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "t, u = np.loadtxt('data.csv', delimiter=';', skiprows=1, unpack=True)\n",
    "\n",
    "plt.plot(t, u, '.-r')\n",
    "plt.xlabel('t (s)')\n",
    "plt.ylabel('u (V)')\n",
    "plt.grid()"
   ]
  }
 ],
