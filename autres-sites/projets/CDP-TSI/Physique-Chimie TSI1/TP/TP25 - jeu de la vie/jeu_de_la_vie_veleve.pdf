def compter_voisins(grille, i, j):
    """
    Compte les voisins vivants de la cellule (i, j).
    Les cellules hors de la grille sont considérées mortes.
    """
    count = 0
    # à compléter
    return count


# ===========================================================
# PARTIE 3 — Règle d'actualisation
# ===========================================================

def update(grille):
    """
    Calcule et retourne la grille à l'étape suivante.
    """
    nb_lignes = len(grille)
    nb_colonnes = len(grille[0])
    nouvelle_grille = [ligne[:] for ligne in grille] # copie un tableau python
    

    
    # à compléter
    
    return nouvelle_grille


# ===========================================================
# Lancement
# ===========================================================
grille = grille_init
for k in range(3):
    plt.figure()
    plt.imshow(grille)
    plt.grid()
    grille = update(grille)
plt.show()