    "## 4. Odeint"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f1d65e40-5f78-4d83-a566-b1d9ee4bc132",
   "metadata": {},
   "outputs": [],
   "source": [
    "from scipy.integrate import odeint\n",
    "\n",
    "# paramètres physiques\n",
    "E = 5 # tension du générateur, [E] = V\n",
    "R = __ # à compléter\n",
    "C = __ # à compléter\n",
    "tau = __ # à compléter\n",
    "\n",
    "\n",
    "# paramètre numérique\n",
    "dt = tau/10\n",
    "t = np.arange(start=0, stop=10*tau, step=dt)\n",
    "\n",
    "def uprime(u, t):\n",
    "    # expression de la dérivée (u') en fonction de la fonction (u) et du temps (t)\n",
    "    uprime = __ # à compléter\n",
    "    return uprime\n",
    "\n",
    "\n",
    "# résolution numérique\n",
    "u0 = 0\n",
    "u = odeint(uprime, u0, t)\n",
    "\n",
    "# theorique\n",
    "u_th = E*(1 - np.exp(-t/tau))\n",
    "\n",
    "# tracé\n",
    "plt.plot(t, u, '.b', label='Odeint')\n",
    "plt.plot(t, u_th, '-r', label='Odeint')\n",
    "plt.grid()"
   ]
