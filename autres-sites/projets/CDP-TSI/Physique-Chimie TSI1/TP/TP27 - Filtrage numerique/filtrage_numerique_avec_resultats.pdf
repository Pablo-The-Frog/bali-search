      "f = 10000 Hz  |  gain theorique = 0.0025  |  gain mesure = 0.0021\n"
     ]
    }
   ],
   "source": [
    "fn_rlc = 500   # Hz\n",
    "Q_rlc = 2\n",
    "\n",
    "for f_test in [50, 500, 10000]:\n",
    "    w_test = 2*np.pi*f_test\n",
    "    wn_test = 2*np.pi*fn_rlc\n",
    "    e_test = np.sin(w_test * t_test)\n",
    "    s_test = filtre_rlc(e_test, t_test, fn_rlc, Q_rlc)\n",
    "    n0 = int(0.85*len(t_test))\n",
    "    amp_mesuree = (s_test[n0:].max() - s_test[n0:].min()) / 2\n",
    "    amp_theo = 1/np.sqrt((1-(w_test/wn_test)**2)**2 + (w_test/(Q_rlc*wn_test))**2)\n",
    "    print(f\"f = {f_test:5d} Hz  |  gain theorique = {amp_theo:.4f}  |  gain mesure = {amp_mesuree:.4f}\")\n"
   ]
  },
