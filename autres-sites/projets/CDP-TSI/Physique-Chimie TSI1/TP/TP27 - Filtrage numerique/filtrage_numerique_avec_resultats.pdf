      "f = 10000 Hz  |  gain theorique = 0.8944  |  gain mesure = 0.9898\n"
     ]
    }
   ],
   "source": [
    "fc_ph = 5000   # entre 500 Hz et 10000 Hz\n",
    "tau_ph = 1 / (2*np.pi*fc_ph)\n",
    "\n",
    "for f_test in [50, 500, 10000]:\n",
    "    w_test = 2*np.pi*f_test\n",
    "    e_test = np.sin(w_test * t_test)\n",
    "    s_test = filtre_passe_haut(e_test, t_test, tau_ph)\n",
    "    n0 = int(0.75*len(t_test))\n",
    "    amp_mesuree = (s_test[n0:].max() - s_test[n0:].min()) / 2\n",
    "    amp_theo = (w_test*tau_ph) / np.sqrt(1+(w_test*tau_ph)**2)\n",
    "    print(f\"f = {f_test:5d} Hz  |  gain theorique = {amp_theo:.4f}  |  gain mesure = {amp_mesuree:.4f}\")\n"
   ]
