     "name": "stdout",
     "output_type": "stream",
     "text": [
      "f =    50 Hz  |  gain theorique = 1.0088  |  gain mesure = 1.0088\n",
      "f =   500 Hz  |  gain theorique = 2.0000  |  gain mesure = 1.9992\n",
      "f = 10000 Hz  |  gain theorique = 0.0025  |  gain mesure = 0.0021\n"
     ]
    },
