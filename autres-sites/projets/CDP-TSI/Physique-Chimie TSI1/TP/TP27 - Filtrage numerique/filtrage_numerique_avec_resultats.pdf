   ],
   "source": [
    "f_axis = np.linspace(1, 20000, 3000)\n",
    "w_axis = 2*np.pi*f_axis\n",
    "\n",
    "fc_demo = 500  # on place la coupure exactement sur la frequence du milieu\n",
    "\n",
    "H_bas = 1 / np.sqrt(1 + (w_axis/(2*np.pi*fc_demo))**2)\n",
    "H_haut = (w_axis/(2*np.pi*fc_demo)) / np.sqrt(1 + (w_axis/(2*np.pi*fc_demo))**2)\n",
    "\n",
    "plt.figure(figsize=(11,4))\n",
    "plt.plot(f_axis, H_bas, color=COULEUR_PASSE_BAS, label='Passe-bas |H(jw)|')\n",
    "plt.plot(f_axis, H_haut, color=COULEUR_PASSE_HAUT, label='Passe-haut |H(jw)|')\n",
    "plt.axvline(fc_demo, color=COULEUR_COUPURE, ls='--', label=f'fc = {fc_demo} Hz')\n",
    "for f0 in (f1, f2, f3):\n",
    "    plt.axvline(f0, color='black', alpha=0.15)\n",
    "plt.xscale('log')\n",
    "plt.xlim(10, 20000)\n",
    "plt.xlabel('Frequence (Hz, echelle log)')\n",
    "plt.ylabel('Gain |H(jw)|')\n",
    "plt.title('Reponses en frequence theoriques (traits noirs fins = nos 3 frequences de test)')\n",
    "plt.legend()\n",
    "plt.show()\n"
   ]
