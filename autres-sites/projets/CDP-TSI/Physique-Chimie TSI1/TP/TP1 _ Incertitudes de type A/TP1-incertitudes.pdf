   "source": [
    "# importation des bibliothèques\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Mesures\n",
    "focale = [] # liste à compléter avec vos mesures\n",
    "\n",
    "# calcul de la moyenne avec numpy\n",
    "moyenne = np.mean(focale)\n",
    "print(f\"f' = {moyenne:.2f}cm\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "561dce14-62b1-4f9f-b82d-bda76f5172dd",
   "metadata": {},
   "outputs": [],
   "source": [
    "# calcul de l'écart type\n",
    "ecart_type = np.std(focale, ddof=1)\n",
    "print(f\"u(f') = {ecart_type:.2f}cm\")"
   ]
  }
 ],
