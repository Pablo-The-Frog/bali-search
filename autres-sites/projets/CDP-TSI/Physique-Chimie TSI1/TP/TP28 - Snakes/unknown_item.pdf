<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta http-equiv="cache-control" content="no-cache"/><title>Basthon Console</title><link rel="icon" type="image/png" href="assets/4a8803c585af3c0cbc9d.png"/><script>var sys_info={"kernel-version":"0.61.1","commit-hash":"c32d0ace43221c15fa497a497c7e03d0514d0355","commit-date":"2023-10-06T10:28:19.000Z"}</script><script defer="defer" src="assets/main.6d26e71f1b4971467be9.js?17f75c513f9e0da97919"></script><link href="assets/main.adbb47e9a71a3e012355.css?17f75c513f9e0da97919" rel="stylesheet"></head><body><div id="container"><div id="left-div"><div id="editor"></div><div style="padding:
8pt 0 0 0;float:left;font-size:0pt"><button id="run" class="btn" title="Exécuter le script"><i class="fas fa-cogs fa-fw btn-logo btn-titled"></i>Exécuter</button> <button id="open" class="btn" title="Ouvrir un script, charger un module ou un fichier"><i class="fas fa-folder-open fa-fw btn-logo"></i></button> <button id="download" class="btn" title="Télécharger le script"><i class="fas fa-download fa-fw btn-logo"></i></button> <button id="share" class="btn" title="Partager ce code"><i class="fas fa-share-alt-square fa-fw btn-logo"></i></button> <button id="hide-editor" class="btn" title="Afficher seulement la console" style="display:none"><i class="fas fa-eye-slash fa-fw btn-logo"></i></button> <button id="rollback" class="btn" title="Revenir à une version précédente du script"><i class="fas fa-undo-alt fa-fw btn-logo"></i></button></div></div><div id="right-div"><div id="graphics" style="display:none;justify-content:center;align-items:center"></div><div id="shell" class="darklighted"></div><div style="padding:
8pt 0 0 0;float:left"><button id="raz" class="btn" title="Redémarrer le noyau"><i class="fas fa-broom fa-fw btn-logo"></i></button> <button id="btn_shell" class="btn" title="Afficher la console"><i class="fas fa-terminal fa-fw btn-logo"></i></button> <button id="btn_graph_view" class="btn" title="Afficher la vue graphique"><i class="fas fa-image fa-fw btn-logo"></i></button> <button id="darklight" class="btn" title="Changer le thème (sombre/lumineux)"><i class="fas fa-adjust fa-fw btn-logo"></i></button> <button id="switch" class="btn" title="Échanger l'éditeur et la console"><i class="fas fa-exchange-alt fa-fw btn-logo"></i></button> <button id="hide-console" class="btn" title="Afficher seulement l'éditeur"><i class="fas fa-eye-slash fa-fw btn-logo"></i></button> <button id="show-editor-console" class="btn" title="Afficher l'éditeur et la console" style="display:none"><i class="fas fa-columns fa-fw btn-logo"></i></button></div></div></div><div id="footer">Cette page est fournie à l'aide de <a target="_blank" rel="noopener noreferrer" href="https://basthon.fr"><img src="assets/82d5b242a39186bcc53c.svg" class="basthon-logo" alt="Basthon"/></a>, logiciel libre qui permet d'exécuter du code Python directement dans votre navigateur, sans être envoyé sur Internet.</div><a id="help" target="_blank" rel="noopener noreferrer" href="https://basthon.fr/doc.html"><i class="far fa-life-ring fa-fw" title="Obtenir de l'aide."></i></a></div></body></html>
