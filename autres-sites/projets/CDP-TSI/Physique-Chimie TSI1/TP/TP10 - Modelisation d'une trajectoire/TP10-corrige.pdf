   ],
   "source": [
    "# détermination de mu\n",
    "mu = m*g/vlim**2\n",
    "print('mu = ', mu, '_unité_') # à compélter l'unité !\n",
    "\n",
    "mu = 1.1e-3  # fonctionne mieux que l\n",
    "\n",
    "\n",
    "# Initialisation des tableaux\n",
    "## Taille des tableaux\n",
    "v_fq_x = np.zeros_like(t)\n",
    "v_fq_y = np.zeros_like(t)\n",
    "x_fq = np.zeros_like(t)\n",
    "y_fq = np.zeros_like(t)\n",
    "\n",
    "## valeurs initiales\n",
    "v_fq_x[0] = v0*np.cos(theta0)\n",
    "v_fq_y[0] = v0*np.sin(theta0)\n",
    "x_fq[0] = 0\n",
    "y_fq[0] = 0\n",
    "\n",
    "delta = m/mu\n",
    "\n",
    "for i in range(1,len(t)):\n",
    "    # position +1\n",
    "    x_fq[i] = x_fq[i-1] + v_fq_x[i-1]*Te\n",
    "    y_fq[i] = y_fq[i-1] + v_fq_y[i-1]*Te\n",
    "    \n",
    "    # vitesse +1\n",
    "    v = np.sqrt(v_fq_x[i-1]**2 + v_fq_y[i-1]**2)\n",
    "    v_fq_x[i] = v_fq_x[i-1] - Te*v*v_fq_x[i-1]/delta\n",
    "    v_fq_y[i] = v_fq_y[i-1] - Te*(g+v*v_fq_y[i-1]/delta)\n",
    "\n",
    "print(v_fq_x)\n",
    "print(v_fq_y)\n",
    "print(x_fq)\n",
    "\n",
    "# Visualisation\n",
    "plt.figure(figsize=(10,6))\n",
    "plt.tight_layout()\n",
    "\n",
    "ax0 = plt.subplot(211)\n",
    "ax0.plot(x_exp, y_exp, '.-r')\n",
    "ax0.plot(x_fq, y_fq, '-k')\n",
    "ax0.grid()\n",
    "ax0.set_title('Trajectoire')\n",
    "ax0.set_xlabel('x (m)')\n",
    "ax0.set_ylabel('y (m)')\n",
    "\n",
    "ax1 = plt.subplot(223)\n",
    "ax1.plot(t,y_exp, '--b')\n",
    "ax1.plot(t,y_fq, '-k')\n",
    "ax1.set_xlabel('t (s)')\n",
    "ax1.set_ylabel('y (m)')\n",
    "ax1.grid()\n",
    "\n",
    "ax2 = plt.subplot(224)\n",
    "ax2.plot(t,x_exp, '--g')\n",
    "ax2.plot(t,x_fq, '-k')\n",
    "ax2.set_xlabel('t (s)')\n",
    "ax2.set_ylabel('x (m)')\n",
    "ax2.grid()"
   ]
  }
