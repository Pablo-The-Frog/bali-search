      " 6.68161507 6.79852122 6.91027414 7.01690481 7.11846218 7.21501522\n",
      " 7.30665315 7.39348454 7.47563551 7.55324737 7.62647404 7.69547937\n",
      " 7.76043448 7.82151528 7.87890027 7.93276849 7.98329786 8.03066371\n",
