     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "694619bc-bcef-4d23-9a68-c8e03e1f90a8",
   "metadata": {},
   "source": [
    "### Paramètres expérimentaux"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "03032821-8d6d-452a-8440-3e3df31a434a",
   "metadata": {},
   "outputs": [],
   "source": [
    "m = 5.3e-3 # masse du volant en kg\n",
    "g = 9.81 # accélération de pesanteur\n",
    "Te = 45e-3 # intervalle de temps entre deux images (s)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1b25ca0d-9fe2-4cf1-b8f0-b67ae68be780",
   "metadata": {},
   "source": [
    "## 1.2 Récupération des données issues de ImageJ"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 82,
   "id": "d5013573-43b3-469c-8638-ccfe41c0c3ad",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[0.    0.045 0.09  0.135 0.18  0.225 0.27  0.315 0.36  0.405 0.45  0.495\n",
      " 0.54  0.585 0.63  0.675 0.72  0.765 0.81  0.855 0.9   0.945 0.99  1.035\n",
      " 1.08  1.125 1.17  1.215 1.26  1.305 1.35  1.395 1.44  1.485 1.53  1.575\n",
      " 1.62  1.665 1.71  1.755 1.8   1.845 1.89  1.935 1.98  2.025]\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x1000 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "p = np.loadtxt('Results.csv', delimiter=\",\", skiprows=1)\n",
    "t = p[:,0]*Te-Te # chargement de la base de temps.\n",
    "x_exp, y_exp = p[:,1], p[:,2] # chargement des données de positions selon x et y.\n",
    "print(t)\n",
    "# center la position de départ sur l'origine\n",
    "x_exp = x_exp-x_exp[0] # translation de toutes les positions selon x\n",
    "y_exp = y_exp-y_exp[0] # translation de toutes les positions selon y\n",
    "\n",
    "plt.figure(figsize=(10,10))\n",
    "plt.tight_layout()\n",
    "\n",
    "ax0 = plt.subplot(211)\n",
    "ax0.plot(x_exp, y_exp, '.-r')\n",
    "ax0.grid()\n",
    "ax0.set_title('Trajectoire')\n",
    "ax0.set_xlabel('x (m)')\n",
    "ax0.set_ylabel('y (m)')\n",
    "\n",
    "ax1 = plt.subplot(223)\n",
    "ax1.plot(t,y_exp, '--b')\n",
    "ax1.set_xlabel('t (s)')\n",
    "ax1.set_ylabel('y (m)')\n",
    "ax1.grid()\n",
    "\n",
    "ax2 = plt.subplot(224)\n",
    "ax2.plot(t,x_exp, '--g')\n",
    "ax2.set_xlabel('t (s)')\n",
    "ax2.set_ylabel('x (m)')\n",
    "ax2.grid()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e5901be0-8e42-4aa1-bed8-5b6e5afea31d",
   "metadata": {},
   "source": [
    "## 1.3 Détermination de $V_0$, $\\theta_0$ et $V_{lim}$."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 84,
   "id": "24958789-830e-4efa-bd6c-775d4597dfc9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "V0 = 38.97745470536323\n",
      "Vlim = 6.542925686817011\n",
      "theta_0 =  50.018765341081114\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x400 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# dérivée de la trajectoire\n",
    "for i in range(len(x)-1):\n",
    "    vx = (x[i+1] - x[i])/Te\n",
    "    vy = (y[i+1] - y[i])/Te   # à compléter.\n",
    "\n",
    "v = np.sqrt((dotx**2 + doty**2))\n",
    "theta = np.arctan(doty/dotx)\n",
    "\n",
    "plt.figure(figsize=(10,4))\n",
    "plt.tight_layout()\n",
    "ax0 = plt.subplot(121)\n",
    "ax0.grid()\n",
    "ax0.set_xlabel('t (s)')\n",
    "ax0.set_ylabel('v (m/s)')\n",
    "plt.plot(t[:-1], v, '.-r')\n",
    "ax1 = plt.subplot(122)\n",
    "plt.plot(t[:-1],theta,'.-b')\n",
    "ax1.grid()\n",
    "ax1.set_xlabel('t (s)')\n",
    "ax1.set_ylabel(r'$\\theta$ (rad)')\n",
    "\n",
    "print('V0 =', v[0])\n",
    "print('Vlim =', v[-1])\n",
    "print('theta_0 = ', theta[0]*180/np.pi)\n",
    "v0 = v[0]\n",
    "theta0 = theta[0]\n",
    "vlim = v[-1]\n",
    "\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f3b55266-c935-4e30-8ebf-76553c59048a",
   "metadata": {},
   "source": [
    "## 2. Modélisation numérique de la trajectoire\n",
    "### 2.1 Modèle sans frottements"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 86,
   "id": "e6cb1a8a-bba3-4c15-bdd2-1c09912f08dc",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[ 0.     1.127  2.254  3.381  4.508  5.635  6.762  7.889  9.016 10.143\n",
      " 11.27  12.397 13.524 14.651 15.778 16.905 18.032 19.159 20.286 21.413\n",
      " 22.54  23.667 24.794 25.921 27.048 28.175 29.302 30.429 31.556 32.683\n",
      " 33.81  34.937 36.064 37.191 38.318 39.445 40.572 41.699 42.826 43.953\n",
      " 45.08  46.207 47.334 48.461 49.588 50.715]\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x600 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "x_sf = v0*np.cos(theta0)*t\n",
    "y_sf = -g*t**2/2 +v0*np.sin(theta0)*t\n",
    "print(x_sf)\n",
    "\n",
    "\n",
    "# tracé\n",
    "plt.figure(figsize=(10,6))\n",
    "plt.tight_layout()\n",
    "\n",
    "ax0 = plt.subplot(211)\n",
    "ax0.plot(x_exp, y_exp, '.-r')\n",
    "ax0.plot(x_sf, y_sf, '-k')\n",
    "ax0.grid()\n",
    "ax0.set_title('Trajectoire')\n",
    "ax0.set_xlabel('x (m)')\n",
    "ax0.set_ylabel('y (m)')\n",
    "\n",
    "ax1 = plt.subplot(223)\n",
    "ax1.plot(t,y_exp, '--b')\n",
    "ax1.plot(t,y_sf, '-k')\n",
    "ax1.set_xlabel('t (s)')\n",
    "ax1.set_ylabel('y (m)')\n",
    "ax1.grid()\n",
    "\n",
    "ax2 = plt.subplot(224)\n",
    "ax2.plot(t,x_exp, '--g')\n",
    "ax2.plot(t,x_sf, '-k')\n",
    "ax2.set_xlabel('t (s)')\n",
    "ax2.set_ylabel('x (m)')\n",
    "ax2.grid()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ba892d0f-2e21-4ac0-98fb-6544b48e9cc7",
   "metadata": {},
   "source": [
    "### 2.2 Modèle de frottement linéaire\n",
    "\n",
    "$$\\overrightarrow{v} = \\left(\\overrightarrow{v}_0 - \\tau\\overrightarrow{g}\\right) \\exp\\left(\\dfrac{-t}{\\tau}\\right) + \\tau\\overrightarrow{g}$$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 171,
   "id": "fe0fcbe4-007b-43fe-9861-07815b616ed3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "lambda =  0.007946445136119749 unité ?\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x600 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# détermination de lambda\n",
    "lamb = m*g / vlim\n",
    "print('lambda = ', lamb, 'unité ?')  # compléter l'unité\n",
    "\n",
    "# détermination de la vitesse\n",
    "tau = m/lamb\n",
    "v_fl_x = np.zeros_like(t)\n",
    "v_fl_y = np.zeros_like(t)\n",
    "for i in range(len(t)):\n",
    "    v_fl_x[i] = v0*np.cos(theta0)*np.exp(-t[i]/tau)\n",
    "    v_fl_y[i] = (v0*np.sin(theta0) + tau*g)*np.exp(-t[i]/tau) -tau*g\n",
    "\n",
    "# détermination de la position\n",
    "x_fl = np.zeros_like(t)\n",
    "y_fl = np.zeros_like(t)\n",
    "for i in range(1,len(t)):\n",
    "    x_fl[i] = x_fl[i-1] + v_fl_x[i-1]*Te\n",
    "    y_fl[i] = y_fl[i-1] + v_fl_y[i-1]*Te\n",
    "\n",
    "\n",
    "\n",
    "# tracé\n",
    "plt.figure(figsize=(10,6))\n",
    "plt.tight_layout()\n",
    "\n",
    "ax0 = plt.subplot(211)\n",
    "ax0.plot(x_exp, y_exp, '.-r')\n",
    "ax0.plot(x_fl, y_fl, '-k')\n",
    "ax0.grid()\n",
    "ax0.set_title('Trajectoire')\n",
    "ax0.set_xlabel('x (m)')\n",
    "ax0.set_ylabel('y (m)')\n",
    "\n",
    "ax1 = plt.subplot(223)\n",
    "ax1.plot(t,y_exp, '--b')\n",
    "ax1.plot(t,y_fl, '-k')\n",
    "ax1.set_xlabel('t (s)')\n",
    "ax1.set_ylabel('y (m)')\n",
    "ax1.grid()\n",
    "\n",
    "ax2 = plt.subplot(224)\n",
    "ax2.plot(t,x_exp, '--g')\n",
    "ax2.plot(t,x_fl, '-k')\n",
    "ax2.set_xlabel('t (s)')\n",
    "ax2.set_ylabel('x (m)')\n",
    "ax2.grid()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2d65bbc6-c45b-4b9a-94d6-874de4543d1f",
